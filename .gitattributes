* text=auto
*.py text eol=lf
*.sql text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.pip text eol=lf
requirements.txt text eol=lf
*.ipynb text eol=lf
# El CSV se conserva byte por byte para mantener su SHA256.
*.csv -text -whitespace
# Los exports SQL recibidos son fuentes originales, no scripts a normalizar.
sql/fuentes/** -text -whitespace
*.pdf binary
*.pptx binary
*.png binary
*.dump binary
*.xlsx binary
