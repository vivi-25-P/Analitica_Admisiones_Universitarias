table DimModalidad

	column Modalidad
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: Modalidad

	partition DimModalidad = m
		mode: import
		source =
				let
				    Valores = Table.Distinct(Table.SelectColumns(BaseUnificadaOrigen, {"modalidad"})),
				    Nombrada = Table.RenameColumns(Valores, {{"modalidad", "Modalidad"}}),
				    Resultado = Table.Sort(Nombrada, {{"Modalidad", Order.Ascending}})
				in
				    Resultado

