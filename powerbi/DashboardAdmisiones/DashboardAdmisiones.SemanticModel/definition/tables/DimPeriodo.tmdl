table DimPeriodo
	lineageTag: efbd136d-5be1-4fab-ab50-0328219c882a

	column Periodo
		dataType: int64
		isKey
		lineageTag: 8f89ea34-eb23-4105-8e7d-d62139d43cf7
		summarizeBy: none
		sourceColumn: Periodo

	partition DimPeriodo = m
		mode: import
		source =
				let
				    Valores = Table.Distinct(Table.SelectColumns(BaseUnificadaOrigen, {"periodo_academico"})),
				    Nombrada = Table.RenameColumns(Valores, {{"periodo_academico", "Periodo"}}),
				    Resultado = Table.Sort(Nombrada, {{"Periodo", Order.Ascending}})
				in
				    Resultado

