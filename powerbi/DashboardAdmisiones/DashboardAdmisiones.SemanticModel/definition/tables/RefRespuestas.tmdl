table RefRespuestas
	lineageTag: 1cd2b6f7-e58e-4cda-8a3a-1737419275b7

	column Referencia
		dataType: string
		lineageTag: 16515864-4d31-4049-8537-2a51310875e1
		summarizeBy: none
		sourceColumn: Referencia

	column 'Pregunta o hipótesis'
		dataType: string
		lineageTag: 0b07b4a3-86a8-409e-a2b8-43c5c89d81c3
		summarizeBy: none
		sourceColumn: Pregunta o hipótesis

	column 'Estado de la respuesta'
		dataType: string
		lineageTag: c7775622-eda3-45cb-b34f-e30eeca71c44
		summarizeBy: none
		sourceColumn: Estado de la respuesta

	column 'Conocimiento obtenido'
		dataType: string
		lineageTag: e8a9e954-a5ac-45e4-9f58-c454402aa08f
		summarizeBy: none
		sourceColumn: Conocimiento obtenido

	partition RefRespuestas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(ArchivoProyecto("reports/analisis_administrativo/tablas/respuestas_preguntas_hipotesis.csv")), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Encabezados, {{"referencia", type text}, {"pregunta_o_hipotesis", type text}, {"estado_de_respuesta", type text}, {"conocimiento_obtenido", type text}}, "en-US"),
				    Listo = Tipos,
				    Porcentajes = Table.TransformColumns(Listo, {}),
				    Columnas = Table.SelectColumns(Porcentajes, {"referencia", "pregunta_o_hipotesis", "estado_de_respuesta", "conocimiento_obtenido"}),
				    Resultado = Table.RenameColumns(Columnas, {{"referencia", "Referencia"}, {"pregunta_o_hipotesis", "Pregunta o hipótesis"}, {"estado_de_respuesta", "Estado de la respuesta"}, {"conocimiento_obtenido", "Conocimiento obtenido"}}),
				    Final = Table.TransformColumns(Resultado, {{"Referencia", each Record.FieldOrDefault([General = "1. General", H1 = "2. Programas", H2 = "3. Canales", H3 = "4. Documentos y asesor", Mercado = "5. Oportunidades"], _, _), type text}, {"Conocimiento obtenido", each Text.Replace(_, "Oracle", "la otra base"), type text}})
				in
				    Final

