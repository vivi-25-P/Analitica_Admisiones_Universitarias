table FactRegistros
	lineageTag: 87f3b6cc-92b9-4ebe-923a-9b771aa9dd07

	measure Registros = COUNTROWS(FactRegistros)
		formatString: #,0
		lineageTag: d0fdf762-cccb-4550-9a02-c236409c0a21

	measure Matriculado = CALCULATE([Registros], DimEstado[Estado] = "Matriculado")
		formatString: #,0
		lineageTag: 7a80efff-7d04-4971-ad65-f039751a1c75

	measure '% Matriculado' = DIVIDE(CALCULATE([Registros], REMOVEFILTERS(DimEstado), REMOVEFILTERS(FactRegistros[estado_proceso]), DimEstado[Estado] = "Matriculado"), CALCULATE([Registros], REMOVEFILTERS(DimEstado), REMOVEFILTERS(FactRegistros[estado_proceso])))
		formatString: 0.0%
		lineageTag: 9ab5fd6e-94b9-49d5-85e4-2d0eac3c4572

	measure '% del total' = DIVIDE([Registros], CALCULATE([Registros], ALLSELECTED()))
		formatString: 0.0%
		lineageTag: 8727f155-876a-46d2-a1b0-7365ab8569df

	measure 'Códigos por origen' = DISTINCTCOUNTNOBLANK(FactRegistros[codigo_origen])
		formatString: #,0
		lineageTag: d668f802-0214-44eb-bd5e-d0f19c6dc762

	measure 'Sin código de aspirante' = CALCULATE([Registros], LEN(FactRegistros[aspirante_id]) = 0)
		formatString: #,0
		lineageTag: 9ed25125-7da0-4649-b804-3ee1e9379137

	measure 'Puntajes informados' = COUNT(FactRegistros[puntaje_admision])
		formatString: #,0
		lineageTag: 6ab161f9-68dc-40e0-9667-0f194ab02624

	measure 'Puntaje mediano' = MEDIAN(FactRegistros[puntaje_admision])
		formatString: 0.0
		lineageTag: 436d0c3b-df32-4cf5-8788-9f1827d34bf3

	measure 'Puntaje promedio' = AVERAGE(FactRegistros[puntaje_admision])
		formatString: 0.0
		lineageTag: 1912d330-ea29-4547-9014-30406602ce5c

	measure 'Importes informados' = COUNT(FactRegistros[valor_matricula_cop])
		formatString: #,0
		lineageTag: 1655e8d1-b01b-4509-8b38-db0897204905

	measure 'Importe mediano' = MEDIAN(FactRegistros[valor_matricula_cop])
		formatString: $ #,0
		lineageTag: 5f48aefe-4220-4e49-adb0-cf730642e626

	measure 'Matriculado sin documentos completos' = CALCULATE([Matriculado], FactRegistros[documentos_completos] <> "Sí")
		formatString: #,0
		lineageTag: 3d5eb422-aacb-4fb3-9cc5-a71fddd72216

	measure '% sin asesor asignado' = DIVIDE(COALESCE(CALCULATE([Registros], KEEPFILTERS(DimAsesor[Asesor] = "Sin asignar")), 0), [Registros])
		formatString: 0.0%
		lineageTag: 2caaa1e0-a1b3-48c5-8676-af11c77dbd01

	measure 'Registros con fecha apta' = CALCULATE([Registros], FactRegistros[fecha_solicitud_apta] = TRUE())
		formatString: #,0
		lineageTag: 406dd51f-0c42-42ee-8e8f-1b83f95ba706

	measure 'Intervalos aptos' = CALCULATE([Registros], FactRegistros[intervalo_apto] = TRUE())
		formatString: #,0
		lineageTag: 67242cc5-7e5f-47e9-adad-45c7357c34db

	measure 'Días medianos a matrícula' = CALCULATE(MEDIAN(FactRegistros[dias_solicitud_matricula]), FactRegistros[intervalo_apto] = TRUE())
		formatString: 0
		lineageTag: 11897d5d-4ab5-4b2b-ac99-1cf3ab3e938e

	measure 'Proporción bruta' = SUM(RefCanalesComparables[% bruto en estratos comunes])
		formatString: 0.00%
		lineageTag: 9bff01cb-ace9-4bb9-bbbe-c5cbf29770e5

	measure 'Proporción con pesos comunes' = SUM(RefCanalesComparables[% con pesos comunes])
		formatString: 0.00%
		lineageTag: 58610373-ba9b-4768-a5b9-bc0faad669b6

	measure 'Brecha bruta entre canales' = 100 * (MAX(RefCanalesComparables[% bruto en estratos comunes]) - MIN(RefCanalesComparables[% bruto en estratos comunes]))
		formatString: 0.00 "pts"
		lineageTag: 498fea57-688a-4fec-8469-8ca18a3cfe8c

	measure 'Brecha con pesos comunes' = 100 * (MAX(RefCanalesComparables[% con pesos comunes]) - MIN(RefCanalesComparables[% con pesos comunes]))
		formatString: 0.00 "pts"
		lineageTag: 668dcf47-eb73-45f1-8181-ed994e9eb146

	measure 'Registros comparables' = SUM(RefCanalesComparables[Registros en estratos comunes])
		formatString: #,0
		lineageTag: 64ee89cb-ee34-45ef-b000-83cde6c88114

	measure 'Cambio máximo con 49 pares' = MAX(RefSensibilidad49[Cambio absoluto])
		formatString: 0.00 "pts"
		lineageTag: 99c16a10-48a9-47e0-a45d-cf9beef18467

	measure 'Tamaño del grupo' = IF([Registros] < 30, "Menos de 30")
		lineageTag: 6a4d1316-bad1-4905-b3f6-0db6f4b2bf99

