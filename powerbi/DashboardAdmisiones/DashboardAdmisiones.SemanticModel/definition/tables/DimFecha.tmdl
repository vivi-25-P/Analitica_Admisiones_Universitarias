table DimFecha
	lineageTag: a001abc4-9334-44f3-a18c-b1d0102ea856
	dataCategory: Time

	column Fecha
		dataType: dateTime
		isKey
		formatString: Long Date
		lineageTag: 975047b6-a38c-49c2-95c6-b2e42f4e9d14
		summarizeBy: none
		sourceColumn: Fecha

		annotation UnderlyingDateTimeDataType = Date

	column Año
		dataType: int64
		lineageTag: 24fa0cff-2c60-4823-98b4-e4f6ac185471
		summarizeBy: none
		sourceColumn: Año

	column 'Número de mes'
		dataType: int64
		lineageTag: b9852cc5-6aaf-43be-b166-60fe45be9926
		summarizeBy: none
		sourceColumn: Número de mes

	column Mes
		dataType: string
		lineageTag: ee12b7af-3a7c-4b1d-9e50-adef08f6cae8
		summarizeBy: none
		sourceColumn: Mes

	partition DimFecha = m
		mode: import
		source =
				let
				    Fechas = List.RemoveNulls(BaseUnificadaOrigen[fecha_solicitud] & BaseUnificadaOrigen[fecha_matricula]),
				    Inicio = #date(Date.Year(List.Min(Fechas)), 1, 1),
				    Fin = #date(Date.Year(List.Max(Fechas)), 12, 31),
				    Dias = List.Dates(Inicio, Duration.Days(Fin - Inicio) + 1, #duration(1, 0, 0, 0)),
				    Tabla = Table.FromList(Dias, Splitter.SplitByNothing(), type table [Fecha = date]),
				    Anio = Table.AddColumn(Tabla, "Año", each Date.Year([Fecha]), Int64.Type),
				    NumeroMes = Table.AddColumn(Anio, "Número de mes", each Date.Month([Fecha]), Int64.Type),
				    Mes = Table.AddColumn(NumeroMes, "Mes", each Date.ToText([Fecha], "yyyy-MM"), type text)
				in
				    Mes

