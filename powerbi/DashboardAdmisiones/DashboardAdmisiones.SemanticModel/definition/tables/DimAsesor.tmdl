table DimAsesor

	column Asesor
		dataType: string
		isKey
		summarizeBy: none
		sourceColumn: Asesor

	partition DimAsesor = m
		mode: import
		source =
				let
				    Valores = Table.Distinct(Table.SelectColumns(BaseUnificadaOrigen, {"asesor"})),
				    Nombrada = Table.RenameColumns(Valores, {{"asesor", "Asesor"}}),
				    Resultado = Table.Sort(Nombrada, {{"Asesor", Order.Ascending}})
				in
				    Resultado

